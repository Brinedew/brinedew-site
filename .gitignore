# Brinedew plugin symlinks. The Quartz v5 install code
# (quartz/cli/plugin-git-handlers.js) creates these at runtime on each
# host using path.resolve() of the repo URL in quartz.config.yaml, so
# the symlink target is host-appropriate. Do NOT commit a symlink here
# with a host-specific absolute target (e.g. D:/...) -- it will fail on
# every other host with ENOENT in regeneratePluginIndex. See B-567
# postmortem in the brinedew Linear workspace.
.quartz/plugins/homepage-crawl-frontier
.quartz/plugins/iconoplasm-page-switcher
.quartz/plugins/tag-sections
.quartz/plugins/draft-tag-injector
.quartz/plugins/image-captions
.quartz/plugins/contact-form
.quartz/plugins/brinedew-components
.quartz/plugins/brinedew-image-captions
.quartz/plugins/brinedew-created-modified-date
.quartz/plugins/brinedew-tag-page
.quartz/plugins/essay-normalizer
.quartz/plugins/footer
.quartz/plugins/publication-date

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Script caches
scripts/uniprot_cache/
*.csv.next

# Syncthing ignore file (not needed in git)
.stignore

# Auto-generated Excalidraw exports (generated from .md files)
**/*.excalidraw.png
**/*.excalidraw.svg

.wrangler/
.wxt/

# Environment files (API keys etc)
.env
.env.*
.dev.vars

# Binary executables (download separately)
scripts/datasets.exe

# Large data files that should be fetched/generated
scripts/topk_ladder.json
scripts/embedding_dump.json

# Root-level junk (temp files, scratch images)
/nul
/tmp/
/artifacts/
/workers/generated/iconoplasm-observability-snapshot.json
