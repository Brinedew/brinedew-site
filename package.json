{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.0.0",
  "packageManager": "pnpm@11.0.9",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "sync:iconoplasm-shared": "node ./scripts/sync-iconoplasm-shared.mjs",
    "sync:iconoplasm-extension": "node ./scripts/sync-iconoplasm-shared.mjs --extension-only",
    "package:iconoplasm-extension": "node ./scripts/package-iconoplasm-extension.mjs",
    "package:iconoplasm-firefox": "node ./scripts/package-iconoplasm-extension.mjs --target=firefox",
    "package:iconoplasm-safari": "node ./scripts/package-iconoplasm-extension.mjs --target=safari",
    "package:iconoplasm-firefox-source": "node ./scripts/package-iconoplasm-firefox-source.mjs",
    "verify:iconoplasm-publisher-authority": "node ./scripts/verify-iconoplasm-publisher-authority.mjs",
    "dev": "pnpm run sync:iconoplasm-shared && node ./quartz/bootstrap-cli.mjs build --serve -d content",
    "build": "pnpm run sync:iconoplasm-shared && node ./quartz/bootstrap-cli.mjs build -d content && pnpm run prepare:iconoplasm-edge-assets",
    "prepare:iconoplasm-edge-assets": "node ./scripts/prepare-iconoplasm-edge-assets.mjs",
    "docs": "pnpm run sync:iconoplasm-shared && node ./quartz/bootstrap-cli.mjs build --serve -d docs",
    "watch": "pnpm run sync:iconoplasm-shared && node ./quartz/bootstrap-cli.mjs watch -d content",
    "check": "tsc --noEmit && pnpm --filter @brinedew/components exec tsc --noEmit && pnpm --filter @brinedew/components exec prettier package.json src --check && pnpm exec prettier . --check",
    "benchmark:iconoplasm-extension": "node ./scripts/benchmark-iconoplasm-extension.mjs",
    "model:iconoplasm-capacity": "node ./scripts/iconoplasm-first-principles-capacity.mjs",
    "verify:iconoplasm-publication-aliases": "node ./scripts/verify-iconoplasm-publication-aliases.mjs",
    "validate:iconoplasm-topology": "node ./scripts/validate-iconoplasm-deployment-topology.mjs",
    "format": "pnpm exec prettier . --write",
    "test": "node scripts/run-tests.mjs",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "node ./quartz/bootstrap-cli.mjs plugin install --from-config"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@floating-ui/dom": "^1.8.0",
    "@mozilla/readability": "^0.6.0",
    "@myriaddreamin/rehype-typst": "^0.6.0",
    "@napi-rs/simple-git": "0.1.22",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.2",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hsluv": "^1.0.2",
    "html-to-text": "^10.0.0",
    "isomorphic-git": "^1.40.0",
    "lightningcss": "^1.33.0",
    "linkedom": "^0.18.13",
    "lit": "3.3.2",
    "micromorph": "^0.4.5",
    "minimatch": "^10.2.6",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.1",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "roughjs": "^4.6.6",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "sirv": "^3.0.2",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "toml": "^3.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.2.0",
    "@quartz-community/types": "github:quartz-community/types#d342893db8240099cfd9d4499996333f1ca636b4",
    "@quartz-community/utils": "github:quartz-community/utils#ff02040c07d0dcb2075994b2acd7cfec710326fa",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.5",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.1",
    "jszip": "3.10.1",
    "prettier": "^3.9.6",
    "publish-browser-extension": "5.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wrangler": "4.115.0",
    "wxt": "0.21.2"
  }
}
