{
  "name": "@brinedew/brinedew-tag-page",
  "version": "0.1.0",
  "description": "Tag page type plugin for Quartz.",
  "type": "module",
  "license": "MIT",
  "author": "Quartz Community",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-community/tag-page"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "tag-page",
    "page-type"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --ignore-path NUL src tsup.config.ts --check",
    "check": "pnpm run typecheck && pnpm run format"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    },
    "vfile": {
      "optional": true
    }
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types#d342893db8240099cfd9d4499996333f1ca636b4",
    "@quartz-community/utils": "github:quartz-community/utils#ff02040c07d0dcb2075994b2acd7cfec710326fa"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "prettier": "^3.9.6",
    "sass": "^1.99.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "brinedew-tag-page",
    "displayName": "Tag Page",
    "category": [
      "pageType",
      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "numPages": 10
    },
    "optionSchema": {
      "numPages": {
        "type": "number"
      }
    }
  }
}
