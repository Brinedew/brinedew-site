{
  "schema_version": 1,
  "renderer": {
    "name": "iconoplasm-pdf-reader",
    "pdfjs_version": "6.2.108",
    "shared_across_certified_targets": true,
    "pdfjs_distribution": "unmodified-pdfjs-dist",
    "filled_pill_pdf_fallback": "pill-outline"
  },
  "targets": {
    "chrome": {
      "driver": "chromium-mime-handler",
      "implementation_complete": true,
      "store_release_ready": true
    },
    "edge": {
      "driver": "chromium-mime-handler",
      "implementation_complete": true,
      "store_release_ready": true
    },
    "firefox": {
      "driver": "firefox-response-filter",
      "implementation_complete": true,
      "http_e2e_certified": true,
      "certified_browser": "Firefox 153.0.4",
      "certified_cases": [
        "GET PDF from real paper bytes",
        "single-use GET without origin replay",
        "POST PDF without request replay",
        "partial-range native fallback",
        "Off handoff to rendered native viewer from captured bytes"
      ],
      "store_release_ready": true,
      "known_limitations": [
        "Local file: PDFs remain in Firefox's native viewer because Firefox exposes no conforming local-file ownership adapter."
      ]
    },
    "safari": {
      "driver": "none",
      "implementation_complete": false,
      "store_release_ready": false,
      "blockers": [
        "Safari WebExtensions expose no response-body ownership primitive equivalent to Chromium mimeHandler or Firefox filterResponseData."
      ]
    }
  }
}
