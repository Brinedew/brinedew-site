{
  "manifest_version": 3,
  "name": "Iconoplasm",
  "version": "0.5.4",
  "description": "Highlights gene symbols on any page with hover cards, portraits, and gene colors. Track your discoveries as you browse.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://iconoplasm.brinedew.bio/*",
    "https://iconoplasmportraits.b-cdn.net/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "iconoplasm@brinedew.bio",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "pdf-reader.html",
      "can_embed": true
    }
  },
  "content_scripts": [
    {
      "matches": ["https://iconoplasm.brinedew.bio/*", "https://staging.brinedew.bio/*"],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://iconoplasm.brinedew.bio/*",
        "https://staging.brinedew.bio/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "generated/iconoplasm-font-runtime.js",
        "generated/rough.js",
        "generated/shared-card-runtime.js",
        "blocklist-defaults.js",
        "content-api.js",
        "content-settings.js",
        "content-matcher.js",
        "content-scanner.js",
        "content-lifecycle.js",
        "content-tooltip.js",
        "content-portrait-cache.js",
        "content-detail-cache.js",
        "content-vote-bridge.js",
        "content-reading-session.js",
        "highlight-runtime.js",
        "content.js"
      ],
      "css": ["generated/shared-card-vote.css", "generated/shared-card-label.css", "content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lit-archival-frame.html",
        "lit-archival-frame.js",
        "content-portrait-cache.js",
        "generated/rough.js",
        "generated/iconoplasm-font-runtime.js",
        "generated/shared-card-runtime.js",
        "generated/shared-card-label.css",
        "generated/shared-card-vote.css",
        "fonts/IBMPlexMono-Regular.woff2",
        "fonts/IBMPlexMono-Medium.woff2",
        "fonts/LeagueSpartan-800.woff2",
        "fonts/SpecialElite-Regular.woff2",
        "fonts/Caveat-400.woff2"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  }
}
