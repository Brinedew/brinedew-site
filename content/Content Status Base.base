formulas:
  stage_label: if(draft == true, "draft", if(status == "in_review", "in review", if(status == "scheduled", "scheduled", if(draft == false, "published", "unknown"))))
  stage_sort: if(formula.stage_label == "draft", 1, if(formula.stage_label == "in review", 2, if(formula.stage_label == "scheduled", 3, if(formula.stage_label == "published", 4, 5))))
  updated_relative: file.mtime.relative()
properties:
  title:
    displayName: Note
  formula.stage_label:
    displayName: Stage
  formula.updated_relative:
    displayName: Updated
  status:
    displayName: Status
views:
  - type: table
    name: Pipeline
    filters:
      or:
        - draft == true
        - status == "in_review"
        - status == "scheduled"
    order:
      - formula.stage_label
      - title
      - formula.updated_relative
      - status
    sort:
      - property: formula.stage_sort
        direction: ASC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.title: 163
  - type: cards
    name: Unpublished
    filters:
      and:
        - draft == true
    order:
      - title
      - file.mtime
    sort:
      - property: file.size
        direction: DESC
    imageFit: ""
    cardSize: 190
    imageAspectRatio: 1
  - type: cards
    name: Published
    filters:
      and:
        - draft == false
    order:
      - title
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: cards
    name: Needs Review
    filters:
      and:
        - status == "in_review"
    order:
      - title
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    imageFit: ""
    cardSize: 190
    imageAspectRatio: 1
  - type: cards
    name: Scheduled
    filters:
      and:
        - status == "scheduled"
    order:
      - publish_date
      - title
    sort:
      - property: publish_date
        direction: ASC
    imageFit: ""
    cardSize: 190
    imageAspectRatio: 1
