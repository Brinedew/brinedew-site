filters:
  and:
    - file.inFolder("wiki")
    - '!file.inFolder("wiki/_backups")'
    - file.ext == "md"
formulas:
  assessment_banner: if(note.vital_level && note.class, "This level-" + note.vital_level.toString() + " vital article is rated " + note.class + "-class.", if(note.class, "Rated " + note.class + "-class.", if(note.vital_level, "Level-" + note.vital_level.toString() + " vital article (unrated).", "Unassessed")))
  vital_sort: if(note.vital_level, note.vital_level, 99)
  class_rank: if(note.class == "FA", 1, if(note.class == "A", 2, if(note.class == "GA", 3, if(note.class == "B", 4, if(note.class == "C", 5, if(note.class == "Start", 6, if(note.class == "Stub", 7, if(note.class == "FL", 8, if(note.class == "List", 9, if(note.class == "NA", 10, 99))))))))))
  updated_relative: file.mtime.relative()
properties:
  title:
    displayName: Note
  vital_level:
    displayName: Vital
  class:
    displayName: Class
  formula.assessment_banner:
    displayName: Assessment
  draft:
    displayName: Draft
  formula.updated_relative:
    displayName: Updated
views:
  - type: table
    name: Assessed Wiki
    filters:
      or:
        - note.class
        - note.vital_level
    order:
      - title
      - vital_level
      - class
      - formula.assessment_banner
      - draft
      - date
    sort:
      - property: vital_level
        direction: ASC
      - property: formula.class_rank
        direction: ASC
      - property: formula.vital_sort
        direction: ASC
    columnSize:
      note.title: 220
      note.vital_level: 70
      note.class: 80
      formula.assessment_banner: 360
  - type: table
    name: Priority Gaps
    filters:
      and:
        - note.vital_level <= 2
        - formula.class_rank >= 4
        - note.class != "NA"
    order:
      - vital_level
      - class
      - title
      - formula.assessment_banner
      - draft
    sort:
      - property: formula.vital_sort
        direction: ASC
      - property: formula.class_rank
        direction: DESC
    columnSize:
      note.title: 220
      note.vital_level: 70
      note.class: 80
      formula.assessment_banner: 360
  - type: table
    name: All Wiki
    order:
      - vital_level
      - class
      - title
      - formula.assessment_banner
      - draft
      - formula.updated_relative
    sort:
      - property: formula.vital_sort
        direction: ASC
      - property: formula.class_rank
        direction: ASC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.title: 220
      note.vital_level: 70
      note.class: 80
      formula.assessment_banner: 360
  - type: table
    name: Unassessed
    filters:
      and:
        - "!note.class"
        - "!note.vital_level"
    order:
      - title
      - draft
      - date
      - formula.updated_relative
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      note.title: 220
