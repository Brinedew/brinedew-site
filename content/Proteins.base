properties:
  mass:
    displayName: Mass (kDa)
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("protein")
    order:
      - file.name
      - length (aa)
      - mass
      - Image link
      - Domains
    sort:
      - property: Image link
        direction: ASC
    columnSize:
      file.name: 258
