{
  "name": "@brinedew/obsidian-prose-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Harper-derived local grammar and explicit whole-document prose-agent checks for Obsidian.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "vite build && vite build --config vite.harper.config.ts && node scripts/copy-static.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:provider": "tsx scripts/smoke-provider.ts",
    "inspect:isolated-obsidian": "node scripts/inspect-isolated-obsidian.mjs",
    "evaluate:agents": "tsx scripts/evaluate-agents.ts",
    "sync:dev-vault": "node scripts/sync-dev-vault.mjs"
  },
  "dependencies": {
    "harper.js": "2.7.0"
  },
  "devDependencies": {
    "@codemirror/lint": "6.8.5",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@types/node": "24.10.1",
    "obsidian": "1.7.2",
    "typescript": "5.9.3",
    "tsx": "4.23.1",
    "vite": "6.4.1",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "@codemirror/lint": "^6.8.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.3"
  }
}
