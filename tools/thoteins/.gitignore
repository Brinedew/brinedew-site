# Python cache and bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual envs (common names)
.venv/
venv/

# App logs and PIDs
logs/
apps/**/logs/
apps/**/mapping-studio.pid

# Mapping autosave (kept outside source by default)
data/mapping.json

# Runtime caches - keep CSVs and UniProt, block bulky databases
data/proteins/hpa/
data/proteins/kegg_*/
data/proteins/mobidb/
data/proteins/rvis/
data/proteins/images/
data/proteins/*.next
!data/proteins/*.csv
!data/proteins/uniprot/
!data/.gitkeep

# Stray app-local logs (standardize on root logs/)
apps/**/*.log

# Dear PyGui caches (safety)
*.dpg.ini

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
