# Python cache and bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual envs (common names)
.venv/
venv/

# App logs and PIDs
logs/
apps/**/logs/
apps/**/mapping-studio.pid

# Mapping autosave (kept outside source by default)
data/mapping.json

# Runtime caches (keep out of source control) - DISABLED for mono-repo
# data/proteins/ 
# Re-enabled data/proteins/ for mono-repo - we need CSVs in git
!data/.gitkeep

# Stray app-local logs (standardize on root logs/)
apps/**/*.log

# Dear PyGui caches (safety)
*.dpg.ini

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
