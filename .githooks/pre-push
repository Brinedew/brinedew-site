#!/usr/bin/env sh
set -eu

# Skip hook logic when explicitly requested.
if [ "${BRINEDEW_SKIP_DEPLOY_HOOK:-0}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

# Check only the pushes that become pull requests: branches other than main.
# A push to main from this laptop is the Obsidian vault's note backup or the
# extension release (its version commit, then its tag), and CI checks main after
# every push anyway. Until 2026-10-05 the vault's hooks pointed at an empty
# folder and a release pushed in seconds. Once they were switched on, the full
# check that used to run here for main took 2 min 38 s on the v0.5.11 release
# commit, and the release's 60-second tag push was killed (2026-10-24).
pushes_a_branch=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/tags/*) ;;
    *) pushes_a_branch=1 ;;
  esac
done
if [ "$pushes_a_branch" = "0" ]; then
  exit 0
fi

if [ ! -d node_modules ]; then
  pnpm install --frozen-lockfile
fi

# The two cheap checks CI's build-and-test runs first. On 2026-10-04 two PRs
# (B-977 #497, B-994 #498) failed CI on Prettier alone and sat red for about six
# hours before anyone looked; a third (#500) failed on stale module stamps. Both
# checks take seconds here and fail the same way CI would.
echo "[pre-push] Prettier and module-stamp checks..."
pnpm run check:format
pnpm run check:stamps

echo "[pre-push] Check passed."
