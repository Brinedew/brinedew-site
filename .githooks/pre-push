#!/usr/bin/env sh
set -eu

# Skip hook logic when explicitly requested.
if [ "${BRINEDEW_SKIP_DEPLOY_HOOK:-0}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

if [ ! -d node_modules ]; then
  pnpm install --frozen-lockfile
fi

# Every branch: the two cheap checks CI's build-and-test runs first. On
# 2026-10-04 two PRs (B-977 #497, B-994 #498) failed CI on Prettier alone and sat
# red for about six hours before anyone looked; a third (#500) failed on stale
# module stamps. Both checks take seconds here and fail the same way CI would.
echo "[pre-push] Prettier and module-stamp checks..."
pnpm run check:format
pnpm run check:stamps

# Main only: the full types + prettier pass. Not a Quartz build: the CI build in
# .github/workflows/deploy-quartz.yml is the canonical production path, and
# building here as well added about 20 s of laptop time per push for nothing.
if [ "$current_branch" = "main" ]; then
  echo "[pre-push] Running pnpm check (types + prettier) for main..."
  pnpm run check
fi

echo "[pre-push] Check passed."
