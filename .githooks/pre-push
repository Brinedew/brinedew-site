#!/usr/bin/env sh
set -eu

# Skip hook logic when explicitly requested.
if [ "${BRINEDEW_SKIP_DEPLOY_HOOK:-0}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

# Only guard production pushes from main.
# This hook is deliberately cheap: a types + prettier pass, not a full
# Quartz build. The full build is owned by .github/workflows/deploy-quartz.yml
# (the canonical production deploy path). Running `npx quartz build` here
# as well used to double-build on every push to main and added ~20s of
# laptop time per push for no benefit — the CI build is the source of
# truth and the GitHub Actions deploy path is what the user dispatches
# via scripts/deploy-cloudflare-prod.ps1.
if [ "$current_branch" != "main" ]; then
  exit 0
fi

echo "[pre-push] Running pnpm check (types + prettier) for main..."

if [ ! -d node_modules ]; then
  pnpm install --frozen-lockfile --no-audit --no-fund
fi

pnpm run check

echo "[pre-push] Check passed."
echo "[pre-push] Canonical production deploy path: scripts/deploy-cloudflare-prod.ps1 -> .github/workflows/deploy-quartz.yml."
